.card h3{margin:0 0 4px;font-size:16px}
.card p{margin:0 0 8px;color:var(--mut);font-size:14px}
a{color:var(--btn);text-decoration:none}
a:hover{text-decoration:underline}
.links a{display:inline-block;margin:0 10px 4px 0;font-size:14px}
.big{display:inline-block;background:var(--btn);color:#fff;border-radius:10px;padding:10px 18px;font-weight:700;margin:4px 0 6px}
